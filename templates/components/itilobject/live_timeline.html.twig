{#
 # =========================================================================
 # LIVE TIMELINE — new messages appear without reloading the page
 # =========================================================================
 #
 # Both parties (requester and technician) share this page, so this single
 # block gives live delivery in both directions.
 #
 # A cheap `count` poll runs every 10s. When the count changes, the rendered
 # entries are fetched once and only the missing ones are inserted into the
 # existing timeline. Nothing is ever removed or replaced, so a reply being
 # written, an open editor or a pending upload are never lost.
 #
 # The poll watches a SIGNATURE, not just the count: approving a solution adds
 # no timeline entry at all, it moves the ticket's status. Watching the number
 # of entries alone is what used to leave a stale Approve/Refuse form on screen.
 #
 # The Approve/Refuse block is handled apart from the entries, because
 # timeline.html.twig includes it on its own, outside the entries partial: no
 # amount of fetching entries could ever bring it in. It is re-rendered by the
 # server and swapped in whole, so its CSRF token and its rich text editor come
 # from the same code path a page load uses.
 #
 # Polling pauses while the tab is hidden and catches up on focus.
 #
 # Installed by bin/install-live-timeline.php — do not edit by hand.
 # =========================================================================
 #}
{% if item is defined and not item.isNewItem() %}
<style>
    .itil-timeline .timeline-item.new-timeline-item .timeline-content {
        animation: glpi-new-message-in 400ms ease-out;
        box-shadow: 0 0 0 2px var(--tblr-primary, #206bc4);
        transition: box-shadow 1s ease-out 3s;
    }
    @keyframes glpi-new-message-in {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @media (prefers-reduced-motion: reduce) {
        .itil-timeline .timeline-item.new-timeline-item .timeline-content {
            animation: none;
        }
    }
</style>
<script type="text/javascript">
(function() {
    var POLL_INTERVAL = 10000;
    var ENDPOINT      = CFG_GLPI.root_doc + '/ajax/livetimeline.php';
    var PARENT_TYPE   = '{{ item.getType()|e('js') }}';
    var ITEMS_ID      = {{ item.fields['id'] }};

    // Lets the global notifier know which ticket is on screen, so a reply
    // arriving here is not announced twice and does not beep twice.
    if (PARENT_TYPE === 'Ticket') {
        window.__glpiOpenTicketId = ITEMS_ID;
    }

    // Signature of the page as the server rendered it, so the very first poll
    // already has something to compare against instead of spending a round
    // adopting. Must match the shape built by `action=count`.
    var PAGE_STATUS   = '{{ item.fields['status']|e('js') }}';
    var PAGE_DATE_MOD = '{{ item.fields['date_mod']|e('js') }}';

    // The approval block lives OUTSIDE the entries partial: timeline.html.twig
    // includes it on its own, so `action=entries` can never carry it. That is
    // why a solution arriving used to leave the reader with no Approve/Refuse
    // form until they reloaded the page. It is fetched and replaced on its own.
    var APPROVAL_ID = 'glpi-live-approval';

    var _known_count     = null;
    var _known_signature = null;
    var _timer           = null;
    var _fetching        = false;
    var _approving       = false;
    var _approval_shown  = false;

    function timelineRoot() {
        return document.querySelector('.itil-timeline');
    }

    function entryKey(node) {
        return node.getAttribute('data-itemtype') + '_' + node.getAttribute('data-items-id');
    }

    /**
     * Entries currently on screen. The main description carries the same data
     * attributes but is not a timeline entry, hence the exclusion.
     */
    function displayedKeys() {
        var keys = {};
        var root = timelineRoot();
        if (!root) {
            return keys;
        }
        root.querySelectorAll('.timeline-item[data-items-id]:not(.ITILContent)').forEach(function(node) {
            keys[entryKey(node)] = node;
        });
        return keys;
    }

    function isNearBottom() {
        return (window.innerHeight + window.pageYOffset) >= (document.body.offsetHeight - 150);
    }

    /**
     * Insert a fetched entry where it belongs, by anchoring it to a sibling
     * already displayed. Keeps the right order for normal and reversed
     * timelines alike, without having to know which one is in use.
     */
    function insertEntry(new_node, fetched, index, displayed) {
        var root = timelineRoot();
        var i;

        for (i = index - 1; i >= 0; i--) {
            var prev = displayed[entryKey(fetched[i])];
            if (prev) {
                prev.parentNode.insertBefore(new_node, prev.nextSibling);
                return;
            }
        }
        for (i = index + 1; i < fetched.length; i++) {
            var next = displayed[entryKey(fetched[i])];
            if (next) {
                next.parentNode.insertBefore(new_node, next);
                return;
            }
        }
        var marker = root.querySelector('.timeline-item.tasks-title');
        if (marker) {
            root.insertBefore(new_node, marker);
        } else {
            root.appendChild(new_node);
        }
    }

    /** Highlight one entry, the way a freshly arrived message is highlighted. */
    function flash(node) {
        node.classList.add('new-timeline-item');
        setTimeout(function() {
            node.classList.remove('new-timeline-item');
        }, 4000);
    }

    /**
     * Bring the message a notification pointed at into view.
     *
     * The browser does jump to the anchor on its own, but the sticky header
     * hides the target and nothing says which message was meant. Listening
     * to hashchange too covers clicking a notification while already here.
     */
    function revealFromHash() {
        var id = window.location.hash.replace(/^#/, '');
        if (!id) {
            return;
        }

        var node = document.getElementById(id);
        if (!node || !node.classList.contains('timeline-item')) {
            return;   // some other anchor on the page: not ours to handle
        }

        node.scrollIntoView({behavior: 'smooth', block: 'center'});
        flash(node);
    }

    function markRead() {
        if (document.hidden) {
            return;
        }
        $.ajax({
            url: ENDPOINT,
            type: 'POST',
            dataType: 'json',
            data: {action: 'mark_read', parenttype: PARENT_TYPE, items_id: ITEMS_ID}
        }).done(function() {
            $(document).trigger('glpi.unread.refresh');
        });
    }

    /**
     * The wrapper holding the approval block.
     *
     * On a page load the block is already there, rendered by the server. It is
     * WRAPPED rather than adopted, so that the wrapper stays the only thing
     * this script ever replaces and there is exactly one .timeline-item per
     * block, whether it came from the page or from a later fetch.
     *
     * @param {boolean} create  build the wrapper when there is nothing to wrap
     */
    function approvalHolder(create) {
        var holder = document.getElementById(APPROVAL_ID);
        if (holder) {
            return holder;
        }

        var root = timelineRoot();
        if (!root) {
            return null;
        }

        // The server-rendered block, recognised by its Approve button.
        // `add_close` is what makes it unambiguous: `add_reopen` also exists
        // as a hidden input in the answer form (form_followup.html.twig), and
        // matching that instead would wrap the wrong item — the answer form
        // sits right next to this block, so the mistake would be invisible
        // until the first refresh replaced the reply box with an approval one.
        var button   = root.querySelector('form button[name="add_close"]');
        var existing = button ? button.closest('.timeline-item') : null;

        if (existing && existing.parentNode) {
            holder = document.createElement('div');
            holder.id = APPROVAL_ID;
            existing.parentNode.insertBefore(holder, existing);
            holder.appendChild(existing);
            return holder;
        }

        if (!create) {
            return null;
        }

        holder = document.createElement('div');
        holder.id = APPROVAL_ID;

        // Where the server would have put it: just before the answer form, at
        // the bottom of the conversation.
        var answer = document.getElementById('new-itilobject-form');
        if (answer && answer.parentNode) {
            answer.parentNode.insertBefore(holder, answer);
        } else {
            root.appendChild(holder);
        }

        return holder;
    }

    /**
     * Bring the approval block in line with the ticket, fetching it or taking
     * it away.
     *
     * The block is rendered by the server, never assembled here: it carries a
     * CSRF token and a rich text editor, and both have to come out of the same
     * code path a page load uses. jQuery's .html() is what makes that work —
     * it evaluates the inline <script> TinyMCE and the upload widget ship
     * with, where plain innerHTML would insert a dead textarea.
     */
    function refreshApproval() {
        if (_approving) {
            return;
        }
        _approving = true;

        $.ajax({
            url: ENDPOINT,
            type: 'GET',
            dataType: 'json',
            data: {action: 'approval', parenttype: PARENT_TYPE, items_id: ITEMS_ID}
        }).done(function(data) {
            if (!data || typeof data.html !== 'string') {
                return;
            }

            var showing = data.html !== '';

            // Already on screen and still wanted: leave it strictly alone. Its
            // token is still valid and its form still posts the same thing, so
            // replacing it would gain nothing — and would throw away a comment
            // the user may be halfway through writing. Same rule the entries
            // follow: nothing on screen is ever removed or replaced.
            if (showing && _approval_shown) {
                return;
            }

            var holder = approvalHolder(showing);

            _approval_shown = showing;

            if (!holder) {
                return;   // nothing on screen, and nothing to put there
            }

            if (!showing) {
                // Never leave an orphaned editor behind: TinyMCE keeps a
                // global registry, and an instance pointing at a textarea that
                // is gone breaks the next one claiming the same id.
                if (typeof tinymce !== 'undefined') {
                    $(holder).find('textarea').each(function() {
                        var editor = this.id ? tinymce.get(this.id) : null;
                        if (editor) {
                            editor.remove();
                        }
                    });
                }

                holder.remove();
                return;
            }

            // .html(), not innerHTML: jQuery evaluates the inline <script> the
            // editor and the upload widget ship with, where innerHTML would
            // leave a dead textarea behind.
            $(holder).html(data.html);

            flash(holder.querySelector('.timeline-item') || holder);
            holder.scrollIntoView({behavior: 'smooth', block: 'nearest'});

            if (typeof glpi_toast_info === 'function') {
                // Signature is (message, caption): body first, title second.
                glpi_toast_info(
                    '{{ __('A solution is waiting for your approval')|e('js') }}',
                    '{{ __('New solution')|e('js') }}',
                    {delay: 8000}
                );
            }
        }).always(function() {
            _approving = false;
        });
    }

    function fetchEntries() {
        if (_fetching) {
            return;
        }
        _fetching = true;

        $.ajax({
            url: ENDPOINT,
            type: 'GET',
            dataType: 'html',
            data: {action: 'entries', parenttype: PARENT_TYPE, items_id: ITEMS_ID}
        }).done(function(html) {
            var root = timelineRoot();
            if (!root) {
                return;
            }

            var holder = document.createElement('div');
            holder.innerHTML = html;

            var fetched = Array.prototype.slice.call(
                holder.querySelectorAll('.timeline-item[data-items-id]:not(.ITILContent)')
            );
            var displayed = displayedKeys();
            var added = [];

            fetched.forEach(function(node, index) {
                if (displayed[entryKey(node)]) {
                    return; // already on screen, never touch it
                }
                insertEntry(node, fetched, index, displayed);
                displayed[entryKey(node)] = node;
                added.push(node);
            });

            if (added.length === 0) {
                return;
            }

            var stick_to_bottom = isNearBottom();

            added.forEach(flash);

            // The LiveChat proper: somebody replied while we were reading.
            if (typeof window.glpiPlayNotificationSound === 'function') {
                window.glpiPlayNotificationSound('sound_a');
            }

            markRead();

            if (stick_to_bottom) {
                added[added.length - 1].scrollIntoView({behavior: 'smooth', block: 'nearest'});
            } else if (typeof glpi_toast_info === 'function') {
                // Signature is (message, caption): body first, title second.
                glpi_toast_info(
                    added.length + ' ' + '{{ __('new message(s) received')|e('js') }}',
                    '{{ __('New message')|e('js') }}',
                    {delay: 5000}
                );
            }
        }).always(function() {
            _fetching = false;
        });
    }

    function poll() {
        if (document.hidden) {
            return;
        }
        $.ajax({
            url: ENDPOINT,
            type: 'GET',
            dataType: 'json',
            data: {action: 'count', parenttype: PARENT_TYPE, items_id: ITEMS_ID}
        }).done(function(data) {
            if (!data || typeof data.count === 'undefined') {
                return;
            }

            // An endpoint that could not build the signature falls back to the
            // count, which is all this used to watch.
            var signature = typeof data.signature === 'string'
                ? data.signature
                : String(data.count);

            if (_known_signature === null) {
                _known_count     = data.count;
                _known_signature = signature;
                return;
            }

            if (signature === _known_signature) {
                return;
            }

            var entries_changed = data.count !== _known_count;

            _known_count     = data.count;
            _known_signature = signature;

            if (entries_changed) {
                fetchEntries();
            }

            // The approval form turns up and goes away on STATUS, which the
            // count cannot see: approving a solution adds no timeline entry at
            // all. Anything having moved is reason enough to ask.
            refreshApproval();
        });
        // network errors are ignored on purpose: the next tick retries
    }

    function start() {
        if (_timer === null) {
            _timer = setInterval(poll, POLL_INTERVAL);
        }
    }

    function stop() {
        if (_timer !== null) {
            clearInterval(_timer);
            _timer = null;
        }
    }

    document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
            stop();
        } else {
            start();
            poll();
            markRead();
        }
    });

    window.addEventListener('beforeunload', stop);
    window.addEventListener('hashchange', revealFromHash);

    $(function() {
        _known_count     = Object.keys(displayedKeys()).length;
        _known_signature = [_known_count, PAGE_STATUS, PAGE_DATE_MOD].join('|');

        // Wrap the block the server already rendered, if there is one, so a
        // later refresh replaces it instead of adding a second one below it.
        _approval_shown = approvalHolder(false) !== null;

        start();
        markRead();
        revealFromHash();
    });
})();
</script>
{% endif %}
