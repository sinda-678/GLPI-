{#
 # Global notifier.
 #
 # Included from the page footer, so it runs on every GLPI page: news is
 # announced whether the user is reading the ticket or somewhere else entirely.
 #
 # Three kinds of news, told apart on purpose:
 #   - a reply on a ticket   -> blue toast,  "New message", sound A
 #   - a ticket just created -> green toast, "New ticket",  sound B
 #   - the ticket moved on   -> its own toast per kind,     sound A
 #     (solution proposed, approved, refused, ticket closed)
 #
 # Polling continues while the tab is hidden or the window is minimised: that
 # is the whole point of the browser notification. Only the first tab to poll
 # announces a given item, because the watermark below is claimed in
 # localStorage, which every tab of the browser shares.
 #
 # State lives in localStorage, not in the database: no table, no migration.
 #}

{# The footer is also rendered on anonymous pages (login, error pages), where
 # polling would only produce 403s. #}
{% if session('glpiID') %}
<script type="text/javascript">
(function() {
    // The footer is rendered once, but guard anyway: a duplicated include
    // would otherwise start a second poller.
    if (window.__glpiLiveNotifier) {
        return;
    }
    window.__glpiLiveNotifier = true;

    // Safety net only. News now arrives through the held request below, within
    // a second; this tick exists for the case where that request cannot run at
    // all -- no storage for the leader key, a proxy that refuses long requests,
    // or a browser that has suspended timers.
    var POLL_INTERVAL = 20000;
    var ENDPOINT      = CFG_GLPI.root_doc + '/ajax/livetimeline.php';

    // The server holds the waiting request open until something happens, so
    // the client must outlive the 25s ceiling the server applies to itself.
    var WAIT_TIMEOUT  = 40000;

    // Only ONE tab per browser keeps a request waiting. A held request occupies
    // a server worker for its whole life, and browsers allow only six
    // connections per host: one per open tab would cost real capacity on both
    // sides and buy nothing, since every tab already shares the same watermark.
    var LEADER_KEY  = 'glpi_live_notifier_leader';
    var LEADER_BEAT = 3000;    // how often the leader tries to say it is alive
    // Silence longer than this means the tab is gone. Generous on purpose:
    // browsers throttle timers in a hidden tab to about once a minute, so a
    // leader that is merely in the background stops beating on schedule. A
    // short window had every hidden tab stealing the role from every other one,
    // each steal opening one more held request. Failover stays immediate in the
    // normal case because a closing tab releases the key on its way out; this
    // only decides how long a CRASHED tab keeps the role.
    var LEADER_TTL  = 90000;
    var TICKET_URL    = CFG_GLPI.root_doc + '/front/ticket.form.php?id=';

    // Timeline entries carry id="<Itemtype>_<id>" (timeline_entries.html.twig),
    // which is what lets a notification point at one entry rather than at the
    // top of the ticket.
    var ANCHOR_FOLLOWUP = 'ITILFollowup';

    // %d is substituted in JS: the count is only known at notification time.
    var LABEL_N_MESSAGES = '{{ __('%d new messages')|e('js') }}';

    // Distinct sounds, so the two kinds of news are told apart without looking.
    var SOUND_MESSAGE = 'sound_a';
    var SOUND_TICKET  = 'sound_b';

    // One watermark per kind: messages and tickets have independent id
    // sequences, and sharing a key would make one kind mask the other.
    var MESSAGE_KEY = 'glpi_live_notifier_last_id';
    var TICKET_KEY  = 'glpi_live_notifier_last_ticket_id';

    // Events are watermarked on TIME, not on an id: approving a solution
    // updates the existing row rather than adding one, so its id never moves
    // and an id watermark would announce the proposal then stay silent on the
    // verdict. The stored value also keeps the keys seen at that exact second,
    // so two events sharing a second cannot hide one another.
    var EVENT_KEY = 'glpi_live_notifier_last_event';

    // How each kind of ticket event is announced. Keyed by the `kind` the
    // server sends, so adding one is a line here and a branch in the SQL.
    var EVENT_LOOKS = {
        solution: {
            title: '{{ __('New solution')|e('js') }}',
            icon:  'ti-bulb',
            tone:  'text-primary-emphasis',
            toast: 'info'
        },
        approved: {
            title: '{{ __('Solution approved')|e('js') }}',
            icon:  'ti-check',
            tone:  'text-success-emphasis',
            toast: 'success'
        },
        refused: {
            title: '{{ __('Solution refused')|e('js') }}',
            icon:  'ti-x',
            tone:  'text-danger-emphasis',
            toast: 'warning'
        },
        closed: {
            title: '{{ __('Ticket closed')|e('js') }}',
            icon:  'ti-lock',
            tone:  'text-secondary-emphasis',
            toast: 'info'
        }
    };

    var _timer = null;
    var _audio_unlocked = false;

    /**
     * Highest id already announced, or null when this browser has never seen
     * this kind of news. The difference matters: null means "adopt whatever
     * is on screen silently", 0 means "the list was empty, announce the next
     * one" — without it a fresh user would swallow their first notification.
     */
    function watermark(key) {
        try {
            var stored = window.localStorage.getItem(key);
            return stored === null ? null : (parseInt(stored, 10) || 0);
        } catch (e) {
            return null;   // private browsing, storage disabled: degrade quietly
        }
    }

    function remember(key, id) {
        try {
            window.localStorage.setItem(key, String(id));
        } catch (e) {
            // nothing to do: without storage the page simply re-notifies later
        }
    }

    /**
     * GLPI builds toasts by string interpolation without escaping, so anything
     * coming from the database has to be escaped here or a ticket title could
     * inject markup into the reader's page.
     */
    function escape(text) {
        if (typeof _ !== 'undefined' && typeof _.escape === 'function') {
            return _.escape(text);
        }
        var node = document.createElement('div');
        node.textContent = text;
        return node.innerHTML;
    }

    // --- sound ------------------------------------------------------------

    /**
     * Two <source> children rather than `new Audio(src)`, so a browser that
     * refuses mp3 falls back to ogg — the same pairing GLPI already ships in
     * public/sound/ and uses in notifications_ajax.js.
     */
    function buildAudio(name) {
        var audio = document.createElement('audio');

        [['mp3', 'audio/mpeg'], ['ogg', 'audio/ogg']].forEach(function(format) {
            var source = document.createElement('source');
            source.src  = CFG_GLPI.root_doc + '/sound/' + name + '.' + format[0];
            source.type = format[1];
            audio.appendChild(source);
        });

        return audio;
    }

    /**
     * Play a notification sound, or stay silent if the browser will not have
     * it. play() returns a promise that rejects under the autoplay policy;
     * leaving it uncaught would print an error on every blocked sound.
     */
    function playSound(name) {
        if (!name) {
            return;
        }

        try {
            var played = buildAudio(name).play();
            if (played && typeof played.catch === 'function') {
                played.catch(function() {});
            }
        } catch (e) {
            // a missing sound must never break the notification that wanted it
        }
    }

    // The in-ticket timeline plays the same sounds: one implementation, shared.
    window.glpiPlayNotificationSound = playSound;

    /**
     * Browsers only allow audio once the user has interacted with the page.
     * Playing one silent sound on that first interaction buys the right to
     * play audible ones later.
     */
    function unlockAudio() {
        if (_audio_unlocked) {
            return;
        }
        _audio_unlocked = true;

        try {
            var audio = buildAudio(SOUND_MESSAGE);
            audio.volume = 0;
            var played = audio.play();
            if (played && typeof played.catch === 'function') {
                played.catch(function() {});
            }
        } catch (e) {
            // ignored: the toast works without any sound
        }
    }

    // --- notifications ----------------------------------------------------

    /** Link to a ticket, and to one precise timeline entry when we know which. */
    function anchorUrl(tickets_id, anchor_type, anchor_id) {
        var url = TICKET_URL + encodeURIComponent(tickets_id);

        if (anchor_type && anchor_id) {
            url += '#' + anchor_type + '_' + encodeURIComponent(anchor_id);
        }

        return url;
    }

    /** Link to a ticket, and to one precise message when we know which. */
    function ticketUrl(tickets_id, followup_id) {
        return anchorUrl(tickets_id, followup_id ? ANCHOR_FOLLOWUP : null, followup_id);
    }

    function notifyDesktop(title, body_text, tag, url) {
        if (typeof Notification === 'undefined' || Notification.permission !== 'granted') {
            return;
        }
        try {
            // The tag collapses repeats of the same news. It carries the kind
            // as well as the ticket, because one ticket can legitimately
            // produce both a "created" and a "replied" notification.
            var notification = new Notification(title, {body: body_text, tag: tag});
            notification.onclick = function() {
                window.focus();
                window.location.href = url;
            };
        } catch (e) {
            // Some browsers throw when constructing notifications outside a
            // service worker: the in-app toast already covered the user.
        }
    }

    /**
     * Toast body: an icon marking the kind, then a link to the message.
     *
     * glpi_toast puts its colour class on the HEADER only; the body keeps
     * `background: var(--tblr-bg-surface)` (see css/includes/_base.scss).
     * A `text-white` link in here is therefore white on white — which is how
     * this toast first shipped, showing the icon and nothing else.
     *
     * The link carries no colour class on purpose: Tabler's own link colour
     * already adapts to the theme (#066fd1 on light, #6aa8e3 on dark) and
     * clears WCAG AA on both, where a fixed `text-primary` would fail the
     * dark theme and a fixed `text-success` would fail the light one.
     *
     * `tone` colours the icon only, and uses the -emphasis variants, which
     * Tabler redefines per theme for exactly this reason.
     */
    function body(icon, tone, url, label) {
        return '<i class="ti ' + icon + ' me-2 ' + tone + '"></i>'
             + '<a href="' + escape(url) + '" class="fw-bold text-decoration-underline">'
             + escape(label)
             + '</a>';
    }

    /**
     * "#42 \u2014 Broken printer". The number carries the weight: ticket titles
     * repeat across a helpdesk, and a notification the reader cannot place is
     * a notification they learn to ignore.
     *
     * \u2014 and \u00b7 are escaped rather than written literally so this file
     * stays pure ASCII and cannot be mangled by an encoding mishap.
     */
    function ticketLabel(tickets_id, name) {
        var label = '#' + tickets_id;

        // A ticket can reach us without a usable title — empty in base, or a
        // field the query did not return. The number alone still identifies
        // it; an empty label would just look broken.
        if (typeof name === 'string' && name.trim() !== '') {
            label += ' \u2014 ' + name.trim();
        }

        return label;
    }

    /**
     * Fold a batch of replies into one entry per ticket.
     *
     * Three answers on the same ticket are one piece of news, not three: as
     * separate toasts they look identical and read as noise. The oldest id of
     * each group is kept, so the link lands where reading should resume.
     */
    function groupMessages(list) {
        var order  = [];
        var groups = {};

        list.forEach(function(message) {
            var key = message.tickets_id;

            if (!groups[key]) {
                groups[key] = {
                    tickets_id: message.tickets_id,
                    ticket:     message.ticket,
                    first_id:   message.id,
                    count:      0
                };
                order.push(key);
            }

            groups[key].count++;
            if (message.id < groups[key].first_id) {
                groups[key].first_id = message.id;
            }
        });

        return order.map(function(key) { return groups[key]; });
    }

    function notifyMessage(group) {
        var title = '{{ __('New message')|e('js') }}';
        var url   = ticketUrl(group.tickets_id, group.first_id);
        var label = ticketLabel(group.tickets_id, group.ticket);

        if (group.count > 1) {
            label += ' \u00b7 ' + LABEL_N_MESSAGES.replace('%d', group.count);
        }

        // Signature is (message, caption): body first, title second.
        glpi_toast_info(body('ti-message-circle', 'text-primary-emphasis', url, label), title, {delay: 8000});

        notifyDesktop(title, label, 'glpi-msg-' + group.tickets_id, url);
    }

    function notifyTicket(ticket) {
        var title = '{{ __('New ticket')|e('js') }}';
        var url   = ticketUrl(ticket.id, null);

        // Green rather than blue: a ticket landing in the queue is work
        // arriving, not a conversation continuing.
        var label = ticketLabel(ticket.id, ticket.name);

        glpi_toast_success(body('ti-ticket', 'text-success-emphasis', url, label), title, {delay: 8000});

        notifyDesktop(title, label, 'glpi-new-' + ticket.id, url);
    }

    /**
     * The ticket moved on: a solution was proposed, approved, refused, or the
     * ticket was closed.
     *
     * Told apart from a reply on purpose. "Somebody answered you" invites you
     * to read; "a solution is waiting for your approval" asks you to act, and
     * "the ticket is closed" tells you it is over. Same shape as the other
     * two, different words, colour and icon.
     */
    function notifyEvent(event) {
        var look = EVENT_LOOKS[event.kind];
        if (!look) {
            return;   // a kind this browser does not know about: stay quiet
        }

        var url   = anchorUrl(event.tickets_id, event.anchor_type, event.anchor_id);
        var label = ticketLabel(event.tickets_id, event.ticket);

        var toasts = {
            info:    typeof glpi_toast_info    === 'function' ? glpi_toast_info    : null,
            success: typeof glpi_toast_success === 'function' ? glpi_toast_success : null,
            warning: typeof glpi_toast_warning === 'function' ? glpi_toast_warning : null
        };
        var toast = toasts[look.toast];

        if (toast) {
            // Signature is (message, caption): body first, title second.
            toast(body(look.icon, look.tone, url, label), look.title, {delay: 8000});
        }

        notifyDesktop(look.title, label, 'glpi-' + event.kind + '-' + event.tickets_id, url);
    }

    /**
     * A message on the ticket the user is currently reading is already handled
     * there: the timeline injects it and plays the sound. Announcing it again
     * globally would double both the toast and the beep.
     *
     * "Currently reading" means the tab is actually on screen. The in-ticket
     * poller pauses while the tab is hidden, so staying silent here would make
     * the one ticket the user has open the only one they are never told about
     * — exactly the case this notifier exists for.
     */
    function onOpenTicket(message) {
        if (document.hidden) {
            return false;
        }

        var open = parseInt(window.__glpiOpenTicketId, 10);

        return !isNaN(open) && open === parseInt(message.tickets_id, 10);
    }

    /**
     * Announce what is newer than the watermark, oldest first so the newest
     * toast ends up on top.
     *
     * @param {Function} [skip]  entries it answers true for are swallowed
     * @param {Function} [group] folds the survivors before they are announced
     * @return {boolean} whether anything was announced
     */
    function announce(list, key, notify, skip, group) {
        if (!Array.isArray(list)) {
            return false;
        }

        var known = watermark(key);

        // First run in this browser: adopt the current state without saying
        // anything, otherwise the user would be flooded with old news.
        if (known === null) {
            remember(key, list.length > 0 ? list[0].id : 0);
            return false;
        }

        var fresh = list.filter(function(entry) {
            return entry.id > known;
        });

        if (fresh.length === 0) {
            return false;
        }

        // Claim the news before showing it, so other open tabs do not announce
        // the same items — and so anything skipped below is not replayed on
        // the next page the user opens.
        remember(key, list[0].id);   // server sorts by id desc

        if (typeof skip === 'function') {
            fresh = fresh.filter(function(entry) {
                return !skip(entry);
            });
        }

        if (fresh.length === 0) {
            return false;
        }

        fresh.reverse();   // oldest first, so the newest toast ends up on top

        if (typeof group === 'function') {
            fresh = group(fresh);
        }

        fresh.forEach(notify);

        return true;
    }

    /**
     * Read the events watermark: the last second announced, and the keys
     * already announced within that second.
     *
     * Returns null when this browser has never seen an event, which means
     * "adopt whatever is there silently" — the same distinction watermark()
     * draws for the id-based feeds.
     */
    function eventWatermark() {
        try {
            var stored = window.localStorage.getItem(EVENT_KEY);
            if (stored === null) {
                return null;
            }

            var state = JSON.parse(stored);

            return {
                ts:   parseInt(state.ts, 10) || 0,
                keys: Array.isArray(state.keys) ? state.keys : []
            };
        } catch (e) {
            // storage disabled, or a value written by an older version:
            // treat it as "never seen" rather than crashing the poll
            return null;
        }
    }

    function rememberEvents(list) {
        var top = list.length > 0 ? (parseInt(list[0].ts, 10) || 0) : 0;

        try {
            window.localStorage.setItem(EVENT_KEY, JSON.stringify({
                ts: top,
                // Only the keys sharing the newest second are worth keeping:
                // anything older is already covered by the timestamp alone.
                keys: list.filter(function(entry) {
                    return (parseInt(entry.ts, 10) || 0) === top;
                }).map(function(entry) {
                    return entry.key;
                })
            }));
        } catch (e) {
            // nothing to do: without storage the page simply re-announces later
        }
    }

    /**
     * Announce the ticket events this browser has not seen yet.
     *
     * Same contract as announce(), watermarked on time instead of on an id.
     * The server sorts by ts descending.
     *
     * @return {Array} the ids of the tickets actually announced, so the caller
     *                 can keep the message feed from repeating the same news
     */
    function announceEvents(list) {
        if (!Array.isArray(list)) {
            return [];
        }

        var known = eventWatermark();

        // First run in this browser: adopt the current state without saying
        // anything, or the user would be greeted by a day of history.
        if (known === null) {
            rememberEvents(list);
            return [];
        }

        var fresh = list.filter(function(entry) {
            var ts = parseInt(entry.ts, 10) || 0;

            return ts > known.ts
                || (ts === known.ts && known.keys.indexOf(entry.key) === -1);
        });

        // Claim the news before showing it, so other open tabs do not announce
        // the same events — and so anything skipped below is not replayed on
        // the next page the user opens.
        rememberEvents(list);

        // What happens on the ticket being read is handled by the page itself,
        // which shows the approval form and says so there.
        fresh = fresh.filter(function(entry) {
            return !onOpenTicket(entry);
        });

        if (fresh.length === 0) {
            return [];
        }

        fresh.reverse();   // oldest first, so the newest toast ends up on top
        fresh.forEach(notifyEvent);

        return fresh.map(function(entry) {
            return entry.tickets_id;
        });
    }

    // Deliberately NOT gated on document.hidden. A hidden tab is precisely
    // when the browser notification below is the only thing that can reach the
    // user, so pausing here made notifyDesktop() unreachable code in the one
    // situation it was written for.
    function poll() {
        $.ajax({
            url: ENDPOINT,
            type: 'GET',
            dataType: 'json',
            data: {action: 'notifications'}
        }).done(function(data) {
            if (!data) {
                return;
            }

            // Events go first, because they decide what the message feed is
            // still allowed to say. Approving a solution writes a followup as
            // well as moving the solution — GLPI fills the comment in with
            // "Solution approved" when the approver left it empty — so the one
            // click would otherwise raise two toasts saying the same thing.
            // Only the tickets announced in THIS round are muted: a genuine
            // reply on a ticket whose solution was settled hours ago is news.
            var announced   = announceEvents(data.events);
            var new_events  = announced.length > 0;
            var event_ticket = {};
            announced.forEach(function(tickets_id) {
                event_ticket[tickets_id] = true;
            });

            var new_messages = announce(
                data.messages,
                MESSAGE_KEY,
                notifyMessage,
                function(message) {
                    return onOpenTicket(message) || event_ticket[message.tickets_id] === true;
                },
                groupMessages
            );

            // `tickets` is absent for helpdesk users: they have no queue.
            var new_tickets = announce(data.tickets, TICKET_KEY, notifyTicket);

            // One sound per round: two overlapping ones just sound broken.
            // News about a conversation the user is part of — a reply, or the
            // fate of a solution — is the more personal, so it wins over work
            // merely landing in the queue.
            if (new_messages || new_events) {
                playSound(SOUND_MESSAGE);
            } else if (new_tickets) {
                playSound(SOUND_TICKET);
            }

            if (new_messages || new_tickets || new_events) {
                // Let the header counter catch up now rather than on its own
                // slower schedule.
                $(document).trigger('glpi.unread.refresh');
            }
        });
        // network errors are ignored on purpose: the next tick will retry
    }

    function start() {
        if (_timer === null) {
            _timer = setInterval(poll, POLL_INTERVAL);
        }
    }

    // --- one waiting tab per browser --------------------------------------

    var _tab_id    = String(Date.now()) + '-' + Math.random().toString(36).slice(2);
    var _signature = null;
    var _waiting   = false;
    var _backoff   = 0;
    var _channel   = null;

    function readLeader() {
        try {
            var raw = window.localStorage.getItem(LEADER_KEY);

            return raw === null ? null : JSON.parse(raw);
        } catch (e) {
            return null;   // private browsing, or a value from an older version
        }
    }

    /**
     * Say we are still alive, but only if we are the one holding the role.
     *
     * Called from the waiting request rather than from a timer: network
     * callbacks are not throttled the way background timers are, and the
     * waiting request completes at least every 25 seconds. That makes the
     * heartbeat follow real work instead of a clock the browser may ignore.
     */
    function refreshLeadership() {
        var held = readLeader();

        if (held !== null && held.id === _tab_id) {
            claimLeadership();
        }
    }

    function claimLeadership() {
        try {
            window.localStorage.setItem(LEADER_KEY, JSON.stringify({id: _tab_id, ts: Date.now()}));
        } catch (e) {
            // Without storage there is no election: every tab waits on its own,
            // which is the old cost but never a wrong result -- the watermark
            // still keeps them from announcing the same thing twice.
        }
    }

    /**
     * Whether this tab is the one holding the waiting request.
     *
     * Also takes the role when nobody holds it, or when the holder stopped
     * saying it was alive: a closed tab, a crashed one, or a laptop that went
     * to sleep. Two tabs can briefly claim it at once; that costs one extra
     * request and settles itself on the next heartbeat.
     */
    function isLeader() {
        var held = readLeader();

        if (held === null || !held.id || (Date.now() - (held.ts || 0)) > LEADER_TTL) {
            claimLeadership();

            return true;
        }

        return held.id === _tab_id;
    }

    function broadcast() {
        if (_channel === null) {
            return;
        }

        try {
            _channel.postMessage({type: 'news'});
        } catch (e) {
            // A closed channel is not worth reporting: the other tabs still
            // catch up on their own safety tick.
        }
    }

    /**
     * Ask the server to answer the moment anything moves, then ask again.
     *
     * The reply carries no news of its own, only "something changed". What the
     * user is shown still comes from poll(), which is answered inside their own
     * session -- so a signal that woke the wrong browser costs one request and
     * can never disclose a ticket.
     */
    function waitLoop() {
        if (_waiting || !isLeader()) {
            return;
        }
        _waiting = true;

        $.ajax({
            url: ENDPOINT,
            type: 'GET',
            dataType: 'json',
            timeout: WAIT_TIMEOUT,
            data: {action: 'wait', signature: _signature === null ? '' : _signature}
        }).done(function(data) {
            _backoff = 0;   // the connection is healthy again

            if (!data || typeof data.signature !== 'string') {
                return;
            }

            // First answer of this tab: adopt the signature without reacting,
            // exactly as the watermarks do on their first run.
            var first  = _signature === null;
            _signature = data.signature;

            if (data.changed === true && !first) {
                poll();       // the tested path: announce, dedupe, refresh badge
                broadcast();  // and let the other tabs refresh their counter
            }
        }).fail(function(xhr) {
            // Network gone, server restarted, proxy cut the connection. Backing
            // off and asking again IS the reconnection: there is no socket to
            // rebuild, which is the main reason a held request is easier to
            // live with here than a persistent one.
            if (xhr && xhr.status === 403) {
                _backoff = 60000;   // logged out: stop hammering the login page
            } else {
                _backoff = Math.min(Math.max(_backoff * 2, 1000), 30000);
            }
        }).always(function() {
            _waiting = false;
            refreshLeadership();

            // 200ms on success rather than 0, so a server answering instantly
            // over and over cannot turn this into a spin.
            window.setTimeout(waitLoop, _backoff === 0 ? 200 : _backoff);
        });
    }

    // Keeps the role alive, and hands it over when its holder disappears.
    window.setInterval(function() {
        if (isLeader()) {
            claimLeadership();
            waitLoop();   // restarts the loop if it ever fell through
        }
    }, LEADER_BEAT);

    // Release the role at once rather than making the others wait out the TTL.
    window.addEventListener('beforeunload', function() {
        var held = readLeader();

        if (held !== null && held.id === _tab_id) {
            try {
                window.localStorage.removeItem(LEADER_KEY);
            } catch (e) {
                // it will expire on its own
            }
        }
    });

    try {
        if (typeof BroadcastChannel !== 'undefined') {
            _channel = new BroadcastChannel('glpi_live_notifier');
            _channel.onmessage = function(event) {
                if (event.data && event.data.type === 'news') {
                    // The leader has already announced it; this tab only needs
                    // its own counter and title brought up to date.
                    $(document).trigger('glpi.unread.refresh');
                }
            };
        }
    } catch (e) {
        _channel = null;   // older browser: the safety tick covers these tabs
    }

    // The timer runs for the whole life of the page, hidden or not. Coming back
    // to the tab earns an immediate poll, and the role too: a toast has to
    // appear where the user is actually looking, and only the leader announces.
    document.addEventListener('visibilitychange', function() {
        if (!document.hidden) {
            claimLeadership();
            poll();
            waitLoop();
        }
    });

    // Browsers reject both permission requests and audio that are not tied to
    // a user gesture, so do the two on the first click rather than on load.
    document.addEventListener('click', function askOnce() {
        document.removeEventListener('click', askOnce);

        unlockAudio();

        if (typeof Notification !== 'undefined' && Notification.permission === 'default') {
            try {
                Notification.requestPermission();
            } catch (e) {
                // ignored: the in-app toast works without any permission
            }
        }
    }, {once: true});

    $(function() {
        poll();
        start();      // safety net
        waitLoop();   // instant delivery, when this tab holds the role
    });
})();
</script>
{% endif %}
