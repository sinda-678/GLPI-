{#
 # Notification counter.
 #
 # Shows what is waiting for the user, the way a messaging app does: replies
 # posted on their tickets since they last opened them, and — for technicians —
 # tickets that arrived in the queue and nobody has opened yet. The two are
 # listed apart, with their own icon and colour, so a glance is enough to tell
 # "someone answered you" from "work came in".
 #
 # The badge is hidden while there is nothing to look at.
 #}

<div class="nav-item dropdown d-flex align-items-center" id="unread-messages-menu">
    <a href="#" class="nav-link px-2 position-relative text-reset"
       data-bs-toggle="dropdown" data-bs-auto-close="outside"
       title="{{ _n('Notification', 'Notifications', 2) }}"
       aria-label="{{ _n('Notification', 'Notifications', 2) }}">
        <i class="ti ti-bell fs-2"></i>
        <span class="badge bg-red text-white position-absolute top-0 end-0 d-none"
              id="unread-messages-badge"
              data-testid="unread-messages-badge">0</span>
    </a>

    <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow mt-1"
         id="unread-messages-list" style="min-width: 20rem;">

        <div class="dropdown-item text-muted" id="unread-messages-empty">
            {{ __('Nothing new') }}
        </div>

        <div class="d-none" id="unread-messages-section">
            <h6 class="dropdown-header d-flex align-items-center">
                <i class="ti ti-message-circle text-blue me-2"></i>{{ __('Unread messages') }}
            </h6>
            <div id="unread-messages-entries"></div>
        </div>

        <div class="d-none" id="new-tickets-section">
            <div class="dropdown-divider d-none" id="new-tickets-divider"></div>
            <h6 class="dropdown-header d-flex align-items-center">
                <i class="ti ti-ticket text-green me-2"></i>{{ __('New tickets') }}
            </h6>
            <div id="new-tickets-entries"></div>
        </div>
    </div>
</div>

<script type="text/javascript">
(function() {
    var POLL_INTERVAL = 30000;
    var ENDPOINT      = CFG_GLPI.root_doc + '/ajax/unreadmessages.php';
    var TICKET_URL    = CFG_GLPI.root_doc + '/front/ticket.form.php?id=';

    // Timeline entries carry id="ITILFollowup_<id>", so the dropdown can drop
    // the user on the first message they have not read yet.
    var ANCHOR_PREFIX = 'ITILFollowup_';

    var _timer = null;

    /**
     * Fill one section of the dropdown.
     *
     * @param {string}  entries_id  container receiving the links
     * @param {string}  section_id  wrapper shown only when there is something
     * @param {Array}   items       entries returned by the server
     * @param {string}  icon        Tabler icon class marking the kind
     * @param {boolean} with_count  show the number of messages per ticket
     * @param {string}  [anchor]    prefix linking to the first unread entry
     * @return {boolean} whether the section has anything in it
     */
    function renderSection(entries_id, section_id, items, icon, with_count, anchor) {
        var entries = document.getElementById(entries_id);
        var section = document.getElementById(section_id);
        if (!entries || !section) {
            return false;
        }

        entries.innerHTML = '';
        items = items || [];

        items.forEach(function(entry) {
            var link = document.createElement('a');
            link.className = 'dropdown-item d-flex align-items-center';
            link.href = TICKET_URL + encodeURIComponent(entry.items_id);

            // Resume where reading stopped rather than at the top of a long
            // ticket. Absent for new tickets: there is no message to aim at.
            if (anchor && entry.first_unread_id) {
                link.href += '#' + anchor + encodeURIComponent(entry.first_unread_id);
            }

            var mark = document.createElement('i');
            mark.className = 'ti ' + icon + ' me-2 text-muted';
            link.appendChild(mark);

            var label = document.createElement('span');
            label.className = 'text-truncate me-2';
            // Same "#42 \u2014 title" shape as the toasts: the number is what
            // lets the reader place a ticket among look-alike titles.
            // textContent, never innerHTML: titles come from the database.
            label.textContent = '#' + entry.items_id + ' \u2014 ' + entry.name;
            link.appendChild(label);

            if (with_count) {
                var count = document.createElement('span');
                count.className = 'badge bg-red text-white ms-auto';
                count.textContent = entry.count;
                link.appendChild(count);
            }

            entries.appendChild(link);
        });

        section.classList.toggle('d-none', items.length === 0);

        return items.length > 0;
    }

    function render(summary) {
        var badge = document.getElementById('unread-messages-badge');
        var empty = document.getElementById('unread-messages-empty');
        if (!badge || !empty) {
            return;
        }

        var total = summary.total || 0;

        if (total > 0) {
            badge.textContent = total > 99 ? '99+' : total;
            badge.classList.remove('d-none');
        } else {
            badge.classList.add('d-none');
        }

        var messages = summary.messages || {};
        var tickets  = summary.tickets  || {};

        // Messages carry a per-ticket count ("3 replies waiting"); a new ticket
        // is one single thing, so a "1" next to it would be noise.
        var has_messages = renderSection(
            'unread-messages-entries', 'unread-messages-section',
            messages.items, 'ti-message-circle', true, ANCHOR_PREFIX
        );
        var has_tickets = renderSection(
            'new-tickets-entries', 'new-tickets-section',
            tickets.items, 'ti-ticket', false, null
        );

        // The divider only makes sense between two populated sections.
        var divider = document.getElementById('new-tickets-divider');
        if (divider) {
            divider.classList.toggle('d-none', !(has_messages && has_tickets));
        }

        empty.classList.toggle('d-none', has_messages || has_tickets);
    }

    function poll() {
        if (document.hidden) {
            return;
        }
        $.ajax({
            url: ENDPOINT,
            type: 'GET',
            dataType: 'json',
            data: {action: 'summary'}
        }).done(function(summary) {
            if (summary && typeof summary.total !== 'undefined') {
                render(summary);
            }
        });
        // network errors are ignored on purpose: the next tick will retry
    }

    function start() {
        if (_timer === null) {
            _timer = setInterval(poll, POLL_INTERVAL);
        }
    }

    function stop() {
        if (_timer !== null) {
            clearInterval(_timer);
            _timer = null;
        }
    }

    document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
            stop();
        } else {
            start();
            poll();
        }
    });

    // Let the ticket page and the global notifier refresh the counter as soon
    // as they know something changed.
    $(document).on('glpi.unread.refresh', poll);

    $(function() {
        poll();
        start();
    });
})();
</script>
